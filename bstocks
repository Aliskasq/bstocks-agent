#!/usr/bin/env python3
"""bStocks CLI entry point — run from anywhere if on PATH."""
import sys
import os

# Add the project root to sys.path so `app` module is importable
repo_root = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, repo_root)

from app.cli import main

if __name__ == "__main__":
    sys.exit(main())