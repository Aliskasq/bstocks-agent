# Copy to .env and fill. NEVER commit .env
OPENROUTER_API_KEY=sk-or-v1-...
# Бесплатная по умолчанию: демо и клики не тратят токены.
# Переключить можно в дашборде (карточка Model) или здесь.
OPENROUTER_MODEL=minimax/minimax-m3:free

# Binance Agent OS (MCP)
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_MCP_TOKEN=

# Risk limits (enforced in Python, not by the LLM)
MAX_POSITION_USD=50
MAX_DAILY_LOSS_USD=10
MAX_TRADES_PER_DAY=3
MAX_LEVERAGE=2

# Set to 1 to use synthetic market data when MCP is unreachable (dev only)
ALLOW_MOCK_MARKET=1

# Binance Agent OS OAuth 2.1 + PKCE (no API key exists for MCP)
# client_id MUST be the public HTTPS URL where you published the metadata doc
BINANCE_OAUTH_CLIENT_ID=
BINANCE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
BINANCE_OAUTH_SCOPES=
